{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "parcel contract",
  "type": "object",
  "properties": {
    "contract": {
      "description": "Contract name, e.g. `sales/orders`. This is what callers put in `FROM`.",
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "inherits": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding": {
      "description": "Where the data is. A child contract may omit it and inherit its parent's.",
      "anyOf": [
        {
          "$ref": "#/$defs/Binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "expose": {
      "description": "The caller's schema. A child contract may omit it (inherit the parent's) or narrow it.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ExposeColumn"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "default": []
    },
    "extensions": {
      "description": "Declared shapes of each namespace's `other` field (design 3.1).",
      "anyOf": [
        {
          "$ref": "#/$defs/Extensions"
        },
        {
          "type": "null"
        }
      ]
    },
    "enrich": {
      "description": "Write-time producers of `row.other` fields (design 10, stage 1).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Enricher"
      }
    },
    "dataset_other": {
      "description": "Write-time producers of `dataset.other` fields (design 10, stage 4).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/DatasetProducer"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "version"
  ],
  "$defs": {
    "Binding": {
      "description": "Where the data physically is. Callers never see this.",
      "type": "object",
      "properties": {
        "parquet": {
          "type": "string"
        },
        "partitioned_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "parquet"
      ]
    },
    "ExposeColumn": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ]
    },
    "Rule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "expr": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "decide"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "expr": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "admit"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "expr": {
              "type": "string"
            },
            "on_fail": {
              "$ref": "#/$defs/AssertOnFail"
            },
            "op": {
              "type": "string",
              "const": "assert"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "expr",
            "on_fail"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "column": {
              "type": "string"
            },
            "expr": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "transform"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "column",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "expr": {
              "type": "string"
            },
            "on_fail": {
              "$ref": "#/$defs/GuaranteeOnFail"
            },
            "op": {
              "type": "string",
              "const": "guarantee"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "expr",
            "on_fail"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "operator": {
              "type": "string"
            },
            "column": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": "object",
              "additionalProperties": true,
              "default": {}
            },
            "unless": {
              "type": [
                "string",
                "null"
              ]
            },
            "op": {
              "type": "string",
              "const": "shape"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "operator"
          ]
        }
      ]
    },
    "AssertOnFail": {
      "type": "string",
      "enum": [
        "drop",
        "deny",
        "report"
      ]
    },
    "GuaranteeOnFail": {
      "type": "string",
      "enum": [
        "deny",
        "annotate"
      ]
    },
    "Extensions": {
      "description": "Field name → type name, per namespace.",
      "type": "object",
      "properties": {
        "row": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ctx": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Enricher": {
      "description": "Computes one `row.other` field from the row, once, at write.",
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "expr": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "expr"
      ]
    },
    "DatasetProducer": {
      "description": "Produces one `dataset.other` field at write: a constant, or an aggregate such as `avg(row.amount)`.",
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "value": true,
        "expr": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "field"
      ]
    }
  }
}
